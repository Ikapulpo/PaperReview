# PubMed API (optional - increases rate limit from 3 to 10 req/sec)
NCBI_API_KEY=

# Notion Integration (required)
NOTION_API_KEY=your_notion_integration_token

# NKT database
NOTION_DATABASE_ID=a1f5b30f-0402-4ddf-a872-c42622d9c27c

# Spine database
SPINE_DATABASE_ID=cec3526e-3831-4769-a814-d8993576ad5e

# Schedule — NKT (default: every Monday 9:00 AM)
SCHEDULE_DAY=monday
SCHEDULE_TIME=09:00

# Schedule — Spine (default: every Monday 9:30 AM)
SPINE_SCHEDULE_DAY=monday
SPINE_SCHEDULE_TIME=09:30
