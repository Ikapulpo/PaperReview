# PubMed API (optional - increases rate limit from 3 to 10 req/sec)
NCBI_API_KEY=

# Notion Integration (required)
NOTION_API_KEY=your_notion_integration_token

# Notion Database — NKT (required for paper-review run)
NOTION_DATABASE_ID=your_database_id_for_週刊NKT

# Notion Database — Spine (required for paper-review spine run)
SPINE_NOTION_DATABASE_ID=your_database_id_for_週刊スパイン

# Anthropic API (required for spine title translation / abstract summarization)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Schedule — NKT (optional - default: every Monday 9:00 AM)
SCHEDULE_DAY=monday
SCHEDULE_TIME=09:00

# Schedule — Spine (optional - default: every Monday 8:00 AM)
SPINE_SCHEDULE_DAY=monday
SPINE_SCHEDULE_TIME=08:00
